{"clickTrackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2ygEE7j9dxw==", "replayChatItemAction": {"actions": [{"clickTrackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2ygEE7j9dxw==", "addChatItemAction": {"item": {"liveChatTextMessageRenderer": {"message": {"runs": [{"text": "سلام علیکم و رحمة الله و برکاته استاد گرامی، در عرف ما اگر کسی فوت کند، زنان محله به خانه متوفی میروند. آیا این کار خلاف شرع است؟ و اگر نه، آیا ذکر خاصی هست که هنگام آنجا بودن باید بگویند؟"}]}, "authorName": {"simpleText": "@БандаШокиров"}, "authorPhoto": {"thumbnails": [{"url": "https://yt4.ggpht.com/ytc/AIdro_nnkxHhutCvSvx9aT5QyA9w9_iMPxhopqIj8d5sZZ0seT27MbxOmqYnY8ZiYQIdbMt_tVc=s32-c-k-c0x00ffffff-no-rj", "width": 32, "height": 32}, {"url": "https://yt4.ggpht.com/ytc/AIdro_nnkxHhutCvSvx9aT5QyA9w9_iMPxhopqIj8d5sZZ0seT27MbxOmqYnY8ZiYQIdbMt_tVc=s64-c-k-c0x00ffffff-no-rj", "width": 64, "height": 64}]}, "contextMenuEndpoint": {"clickTrackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2ygEE7j9dxw==", "commandMetadata": {"webCommandMetadata": {"ignoreNavigation": true}}, "liveChatItemContextMenuEndpoint": {"params": "Q2g0S0hBb2FRMDF5VkdvMVpsTnlOVmxFUmxGdlJrWlJWV1JsTkVWMU9FRWFLU29uQ2hoVlEyTldOemMyUWpWbE1UaG9iR0l4WlVaV2JtSnJTMmNTQzJaTU0wTlZWSFZOVERKUklBRW9BVElhQ2hoVlEyaGhNMlpoVlhWT1NrSnpWV0pDU1haZlVHcGFNRkU0QWtnQlVBRSUzRA=="}}, "id": "ChwKGkNNclRqNWZTcjVZREZRb0ZGUVVkZTRFdThB", "timestampUsec": "1787243851412325", "authorExternalChannelId": "UCha3faUuNJBsUbBIv_PjZ0Q", "contextMenuAccessibility": {"accessibilityData": {"label": "Chat actions"}}, "timestampText": {"simpleText": "6:55"}, "trackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2"}}, "clientId": "CMrTj5fSr5YDFQoFFQUde4Eu8A"}}], "videoOffsetTimeMsec": "415382"}}
{"clickTrackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2ygEE7j9dxw==", "replayChatItemAction": {"actions": [{"clickTrackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2ygEE7j9dxw==", "addChatItemAction": {"item": {"liveChatTextMessageRenderer": {"message": {"runs": [{"text": "سوال دیگرم این بود که برادری پرسید که مسجد جمعه نزدیک است، اما به دلیل عذری که دارم نمیتوانم بروم و نماز پیشین را حتما بعد از نماز جمعه بخوانم؟ جزاکم الله خیرا"}]}, "authorName": {"simpleText": "@БандаШокиров"}, "authorPhoto": {"thumbnails": [{"url": "https://yt4.ggpht.com/ytc/AIdro_nnkxHhutCvSvx9aT5QyA9w9_iMPxhopqIj8d5sZZ0seT27MbxOmqYnY8ZiYQIdbMt_tVc=s32-c-k-c0x00ffffff-no-rj", "width": 32, "height": 32}, {"url": "https://yt4.ggpht.com/ytc/AIdro_nnkxHhutCvSvx9aT5QyA9w9_iMPxhopqIj8d5sZZ0seT27MbxOmqYnY8ZiYQIdbMt_tVc=s64-c-k-c0x00ffffff-no-rj", "width": 64, "height": 64}]}, "contextMenuEndpoint": {"clickTrackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2ygEE7j9dxw==", "commandMetadata": {"webCommandMetadata": {"ignoreNavigation": true}}, "liveChatItemContextMenuEndpoint": {"params": "Q2g0S0hBb2FRMGwyVldkS2JsTnlOVmxFUmxSRFNsOTNVV1JyWkVFM1kwRWFLU29uQ2hoVlEyTldOemMyUWpWbE1UaG9iR0l4WlVaV2JtSnJTMmNTQzJaTU0wTlZWSFZOVERKUklBRW9BVElhQ2hoVlEyaGhNMlpoVlhWT1NrSnpWV0pDU1haZlVHcGFNRkU0QWtnQlVBRSUzRA=="}}, "id": "ChwKGkNJdlVnSm5TcjVZREZUQ0pfd1Fka2RBN2NB", "timestampUsec": "1787243855369434", "authorExternalChannelId": "UCha3faUuNJBsUbBIv_PjZ0Q", "contextMenuAccessibility": {"accessibilityData": {"label": "Chat actions"}}, "timestampText": {"simpleText": "6:59"}, "trackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2"}}, "clientId": "CIvUgJnSr5YDFTCJ_wQdkdA7cA"}}], "videoOffsetTimeMsec": "419341"}}
{"clickTrackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2ygEE7j9dxw==", "replayChatItemAction": {"actions": [{"clickTrackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2ygEE7j9dxw==", "addChatItemAction": {"item": {"liveChatTextMessageRenderer": {"message": {"runs": [{"text": "سلام علیکم امید که صحتمند باشید سوالم درباره این است که گفته شده بعد نماز فجر خوابیدن کراهت دارد آیا این نخوابیدن مربوط به بعد آذان فجر هست یا به بعد جماعت آن چون بین آذان وجماعت فجر ساعات متفاوت هست"}]}, "authorName": {"simpleText": "@sahellazam"}, "authorPhoto": {"thumbnails": [{"url": "https://yt4.ggpht.com/ytc/AIdro_k6KCWwWWazZDPw7N6gHc5MygbBe9lzbV1nJ1lrTtK3sBtiA9u7vvUL0-Qe0H9JOGkVZw=s32-c-k-c0x00ffffff-no-rj", "width": 32, "height": 32}, {"url": "https://yt4.ggpht.com/ytc/AIdro_k6KCWwWWazZDPw7N6gHc5MygbBe9lzbV1nJ1lrTtK3sBtiA9u7vvUL0-Qe0H9JOGkVZw=s64-c-k-c0x00ffffff-no-rj", "width": 64, "height": 64}]}, "contextMenuEndpoint": {"clickTrackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2ygEE7j9dxw==", "commandMetadata": {"webCommandMetadata": {"ignoreNavigation": true}}, "liveChatItemContextMenuEndpoint": {"params": "Q2g0S0hBb2FRMHBZV2pnM1RGTnlOVmxFUmxOalp6Rm5RV1EyT0UxU1RGRWFLU29uQ2hoVlEyTldOemMyUWpWbE1UaG9iR0l4WlVaV2JtSnJTMmNTQzJaTU0wTlZWSFZOVERKUklBRW9BVElhQ2hoVlEyTkZXbmxKVTFCdlNFeDBkblF0YzNCemJ6ZDRPWGM0QWtnQlVBRSUzRA=="}}, "id": "ChwKGkNKWFo4N0xTcjVZREZTY2cxZ0FkNjhNUkxR", "timestampUsec": "1787243909685497", "authorExternalChannelId": "UCcEZyISPoHLtvt-spso7x9w", "contextMenuAccessibility": {"accessibilityData": {"label": "Chat actions"}}, "timestampText": {"simpleText": "7:53"}, "trackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2"}}, "clientId": "CJXZ87LSr5YDFScg1gAd68MRLQ"}}], "videoOffsetTimeMsec": "473658"}}
