{"clickTrackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2ygEE7j9dxw==", "replayChatItemAction": {"actions": [{"clickTrackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2ygEE7j9dxw==", "addChatItemAction": {"item": {"liveChatTextMessageRenderer": {"message": {"runs": [{"text": "سلام علیکم ورحمه الله وبرکاته استاد عزیز اگر خواندن روزانه قرآن کریم که روزانه میخونیم و جز که سوره مبارکه کهف شامل آن است در آن روز برابر بشه همان سنت خواندن سوره کهف حساب میشود"}]}, "authorName": {"simpleText": "@mohammadtarigyaqubi3928"}, "authorPhoto": {"thumbnails": [{"url": "https://yt4.ggpht.com/KAJQkKGVzwKpsqUfVdQe_xkpAErgOyPpbgETVia-qN9U4jgJrLx65BIBt40hgnxlN2IGaVPmwh4=s32-c-k-c0x00ffffff-no-rj", "width": 32, "height": 32}, {"url": "https://yt4.ggpht.com/KAJQkKGVzwKpsqUfVdQe_xkpAErgOyPpbgETVia-qN9U4jgJrLx65BIBt40hgnxlN2IGaVPmwh4=s64-c-k-c0x00ffffff-no-rj", "width": 64, "height": 64}]}, "contextMenuEndpoint": {"clickTrackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2ygEE7j9dxw==", "commandMetadata": {"webCommandMetadata": {"ignoreNavigation": true}}, "liveChatItemContextMenuEndpoint": {"params": "Q2g0S0hBb2FRMHh1WXpOaFZGUnlOVmxFUm1SdmF6Rm5RV1JNU2xGVmRVRWFLU29uQ2hoVlEyTldOemMyUWpWbE1UaG9iR0l4WlVaV2JtSnJTMmNTQzJaTU0wTlZWSFZOVERKUklBRW9BVElhQ2hoVlExSTBTVXhtVmxkUmJqaFNXbmsxV1RaWmRYSkdhVUU0QWtnQlVBRSUzRA=="}}, "id": "ChwKGkNMbmMzYVRUcjVZREZkb2sxZ0FkTEpRVXVB", "timestampUsec": "1787244148397008", "authorExternalChannelId": "UCR4ILfVWQn8RZy5Y6YurFiA", "contextMenuAccessibility": {"accessibilityData": {"label": "Chat actions"}}, "timestampText": {"simpleText": "11:52"}, "trackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2"}}, "clientId": "CLnc3aTTr5YDFdok1gAdLJQUuA"}}], "videoOffsetTimeMsec": "712380"}}
{"clickTrackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2ygEE7j9dxw==", "replayChatItemAction": {"actions": [{"clickTrackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2ygEE7j9dxw==", "addChatItemAction": {"item": {"liveChatTextMessageRenderer": {"message": {"runs": [{"text": "شیخم از شاگردان شما هستم و همزمان در دوره تفسیر و دوره عقیده نیز ثبت نام کردم و میخواهم پیش ببرم، آیا شما اجازه میدهید و اشکالی نمیبینید ، الحمدلله توانایی پیش بردن انرا دارم و دوست دارم دروس تان را"}]}, "authorName": {"simpleText": "@AhmadjawadWafi"}, "authorPhoto": {"thumbnails": [{"url": "https://yt4.ggpht.com/dRmRiMsr85oiRjrg-1A9RhZkQOg0cHejBMwSXqIKxXmv39lYGWM3KO45k4RVmgmXCtOBd8yMQQ=s32-c-k-c0x00ffffff-no-rj", "width": 32, "height": 32}, {"url": "https://yt4.ggpht.com/dRmRiMsr85oiRjrg-1A9RhZkQOg0cHejBMwSXqIKxXmv39lYGWM3KO45k4RVmgmXCtOBd8yMQQ=s64-c-k-c0x00ffffff-no-rj", "width": 64, "height": 64}]}, "contextMenuEndpoint": {"clickTrackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2ygEE7j9dxw==", "commandMetadata": {"webCommandMetadata": {"ignoreNavigation": true}}, "liveChatItemContextMenuEndpoint": {"params": "Q2g0S0hBb2FRMHBRTnpoaFZGUnlOVmxFUmxaS2JuRjNTV1J1U2xGNFlsRWFLU29uQ2hoVlEyTldOemMyUWpWbE1UaG9iR0l4WlVaV2JtSnJTMmNTQzJaTU0wTlZWSFZOVERKUklBRW9BVElhQ2hoVlEyY3pObmxtTjNSblkxRmxZMVJCVVMxVFdtMURiVUU0QWtnQlVBRSUzRA=="}}, "id": "ChwKGkNKUDc4YVRUcjVZREZWSm5xd0lkbkpReGJR", "timestampUsec": "1787244148721736", "authorExternalChannelId": "UCg36yf7tgcQecTAQ-SZmCmA", "contextMenuAccessibility": {"accessibilityData": {"label": "Chat actions"}}, "timestampText": {"simpleText": "11:52"}, "trackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2"}}, "clientId": "CJP78aTTr5YDFVJnqwIdnJQxbQ"}}], "videoOffsetTimeMsec": "712700"}}
{"clickTrackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2ygEE7j9dxw==", "replayChatItemAction": {"actions": [{"clickTrackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2ygEE7j9dxw==", "addChatItemAction": {"item": {"liveChatTextMessageRenderer": {"message": {"runs": [{"text": "سلام علیکم استاد من یک دوکان دارم مدت یک سال شده است که مقدار جنس اش ۲ لک افغانی میشود و خودم ۱۸۰هزار افغانی قرضداراستم آیا بالای من ذکات میشود"}]}, "authorName": {"simpleText": "@MohammadAyoub-s2h"}, "authorPhoto": {"thumbnails": [{"url": "https://yt4.ggpht.com/ytc/AIdro_nQnix-VeJ6EdB4XIG9FFgrkb8_vpSDP2Ft1Cp8cNbPAPogyXsBLaYw96po1fV2IWNUFw=s32-c-k-c0x00ffffff-no-rj", "width": 32, "height": 32}, {"url": "https://yt4.ggpht.com/ytc/AIdro_nQnix-VeJ6EdB4XIG9FFgrkb8_vpSDP2Ft1Cp8cNbPAPogyXsBLaYw96po1fV2IWNUFw=s64-c-k-c0x00ffffff-no-rj", "width": 64, "height": 64}]}, "contextMenuEndpoint": {"clickTrackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2ygEE7j9dxw==", "commandMetadata": {"webCommandMetadata": {"ignoreNavigation": true}}, "liveChatItemContextMenuEndpoint": {"params": "Q2g0S0hBb2FRMDVEWlRsalNGUnlOVmxFUm1OdmRERm5RV1E0VFVWRFRHY2FLU29uQ2hoVlEyTldOemMyUWpWbE1UaG9iR0l4WlVaV2JtSnJTMmNTQzJaTU0wTlZWSFZOVERKUklBRW9BVElhQ2hoVlF6RXdhMjQyZGpKb2MzaFVRVEJuY1VOb1RGUkVaVUU0QWtnQlVBRSUzRA=="}}, "id": "ChwKGkNOQ2U5Y0hUcjVZREZjb3QxZ0FkOE1FQ0xn", "timestampUsec": "1787244209598270", "authorExternalChannelId": "UC10kn6v2hsxTA0gqChLTDeA", "contextMenuAccessibility": {"accessibilityData": {"label": "Chat actions"}}, "timestampText": {"simpleText": "12:53"}, "trackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2"}}, "clientId": "CNCe9cHTr5YDFcot1gAd8MECLg"}}], "videoOffsetTimeMsec": "773578"}}
{"clickTrackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2ygEE7j9dxw==", "replayChatItemAction": {"actions": [{"clickTrackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2ygEE7j9dxw==", "addChatItemAction": {"item": {"liveChatTextMessageRenderer": {"message": {"runs": [{"text": "آیا اگر کسی با هر روشی توانست از دست مجازات قطع دست برای دزدی قصر در برود به نا حق آیا بعد از توبه و پشیمانی باید خودش را معرفی میکند تا دستش را قطع کند و تا هر زمان که این دست را دارد براش گناه نوش"}]}, "authorName": {"simpleText": "@AMIEHDUIEJ.277"}, "authorPhoto": {"thumbnails": [{"url": "https://yt4.ggpht.com/ytc/AIdro_lImVEFshLCzwKPwsKil_wI44W3fLO5VgHisdM_-Jtm5ZMsPSMXFTRot9-tSU3zW38Ftw=s32-c-k-c0x00ffffff-no-rj", "width": 32, "height": 32}, {"url": "https://yt4.ggpht.com/ytc/AIdro_lImVEFshLCzwKPwsKil_wI44W3fLO5VgHisdM_-Jtm5ZMsPSMXFTRot9-tSU3zW38Ftw=s64-c-k-c0x00ffffff-no-rj", "width": 64, "height": 64}]}, "contextMenuEndpoint": {"clickTrackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2ygEE7j9dxw==", "commandMetadata": {"webCommandMetadata": {"ignoreNavigation": true}}, "liveChatItemContextMenuEndpoint": {"params": "Q2g0S0hBb2FRMDh6U0RaUE4xUnlOVmxFUmxSbVpsQjNVV1I2TVRoWVpIY2FLU29uQ2hoVlEyTldOemMyUWpWbE1UaG9iR0l4WlVaV2JtSnJTMmNTQzJaTU0wTlZWSFZOVERKUklBRW9BVElhQ2hoVlExOUpla3A1WmxGYVFtZEtlV2RKVTNoR1dXeFlPSGM0QWtnQlVBRSUzRA=="}}, "id": "ChwKGkNPM0g2TzdUcjVZREZUZmZQd1FkejE4WGR3", "timestampUsec": "1787244303759400", "authorExternalChannelId": "UC_IzJyfQZBgJygISxFYlX8w", "contextMenuAccessibility": {"accessibilityData": {"label": "Chat actions"}}, "timestampText": {"simpleText": "14:27"}, "trackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2"}}, "clientId": "CO3H6O7Tr5YDFTffPwQdz18Xdw"}}], "videoOffsetTimeMsec": "867759"}}
{"clickTrackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2ygEE7j9dxw==", "replayChatItemAction": {"actions": [{"clickTrackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2ygEE7j9dxw==", "addChatItemAction": {"item": {"liveChatTextMessageRenderer": {"message": {"runs": [{"text": "در یک مجلس گفتم که بلند کردن دستها تا مقابل شانهها هنگام تکبیر اول نماز، از سنتهای رسول الله صلی الله علیه وسلم است. شخصی در پاسخ، با نیت رد کردن این سنت گفت:"}]}, "authorName": {"simpleText": "@RawdatulIman"}, "authorPhoto": {"thumbnails": [{"url": "https://yt4.ggpht.com/kKcfI3qLqVzJiAO2A5g08bgs9y0kInAXQB7Isxp1SBj0lvj_0HHnJFM5aUHFQ-NRxMiOi0jLKA=s32-c-k-c0x00ffffff-no-rj", "width": 32, "height": 32}, {"url": "https://yt4.ggpht.com/kKcfI3qLqVzJiAO2A5g08bgs9y0kInAXQB7Isxp1SBj0lvj_0HHnJFM5aUHFQ-NRxMiOi0jLKA=s64-c-k-c0x00ffffff-no-rj", "width": 64, "height": 64}]}, "contextMenuEndpoint": {"clickTrackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2ygEE7j9dxw==", "commandMetadata": {"webCommandMetadata": {"ignoreNavigation": true}}, "liveChatItemContextMenuEndpoint": {"params": "Q2g0S0hBb2FRMDlEU1MxSlRGWnlOVmxFUmxZNGRURm5RV1JIZEZsWlRIY2FLU29uQ2hoVlEyTldOemMyUWpWbE1UaG9iR0l4WlVaV2JtSnJTMmNTQzJaTU0wTlZWSFZOVERKUklBRW9BVElhQ2hoVlEyMXVObkkxYzFCVlduaHhSakYzVDJWZlIwOVJhRkU0QWtnQlVBRSUzRA=="}}, "id": "ChwKGkNPQ0ktSUxWcjVZREZWOHUxZ0FkR3RZWUx3", "timestampUsec": "1787244614397595", "authorExternalChannelId": "UCmn6r5sPUZxqF1wOe_GOQhQ", "contextMenuAccessibility": {"accessibilityData": {"label": "Chat actions"}}, "timestampText": {"simpleText": "19:38"}, "trackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2"}}, "clientId": "COCI-ILVr5YDFV8u1gAdGtYYLw"}}], "videoOffsetTimeMsec": "1178371"}}
