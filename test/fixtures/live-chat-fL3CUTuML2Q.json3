{"clickTrackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2ygEE7j9dxw==", "replayChatItemAction": {"actions": [{"clickTrackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2ygEE7j9dxw==", "addChatItemAction": {"item": {"liveChatTextMessageRenderer": {"message": {"runs": [{"text": "سلام علیکم شیخم،چرا سلیمان رحیلی که پروفیسور اصول فقه است خیلی متشدد است و بر شیخ طریفی رد میکنه و میگه از منحرفین است و تاپه اخوان میزنه به ، شیخ طریفی چرا ،،، طریفی از نظر علمی از رحیلی کرده بالا"}]}, "authorName": {"simpleText": "@AhmadjawadWafi"}, "authorPhoto": {"thumbnails": [{"url": "https://yt4.ggpht.com/dRmRiMsr85oiRjrg-1A9RhZkQOg0cHejBMwSXqIKxXmv39lYGWM3KO45k4RVmgmXCtOBd8yMQQ=s32-c-k-c0x00ffffff-no-rj", "width": 32, "height": 32}, {"url": "https://yt4.ggpht.com/dRmRiMsr85oiRjrg-1A9RhZkQOg0cHejBMwSXqIKxXmv39lYGWM3KO45k4RVmgmXCtOBd8yMQQ=s64-c-k-c0x00ffffff-no-rj", "width": 64, "height": 64}]}, "contextMenuEndpoint": {"clickTrackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2ygEE7j9dxw==", "commandMetadata": {"webCommandMetadata": {"ignoreNavigation": true}}, "liveChatItemContextMenuEndpoint": {"params": "Q2g0S0hBb2FRMUJ0VHpJNGRsTnlOVmxFUm1aMmJsQjNVV1JsWDNkc1RtY2FLU29uQ2hoVlEyTldOemMyUWpWbE1UaG9iR0l4WlVaV2JtSnJTMmNTQzJaTU0wTlZWSFZOVERKUklBRW9BVElhQ2hoVlEyY3pObmxtTjNSblkxRmxZMVJCVVMxVFdtMURiVUU0QWtnQlVBRSUzRA=="}}, "id": "ChwKGkNQbU8yOHZTcjVZREZmdm5Qd1FkZV93bE5n", "timestampUsec": "1787243961703328", "authorExternalChannelId": "UCg36yf7tgcQecTAQ-SZmCmA", "contextMenuAccessibility": {"accessibilityData": {"label": "Chat actions"}}, "timestampText": {"simpleText": "8:45"}, "trackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2"}}, "clientId": "CPmO28vSr5YDFfvnPwQde_wlNg"}}], "videoOffsetTimeMsec": "525684"}}
