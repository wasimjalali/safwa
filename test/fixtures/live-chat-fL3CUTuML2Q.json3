{"clickTrackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2ygEE7j9dxw==", "replayChatItemAction": {"actions": [{"clickTrackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2ygEE7j9dxw==", "addChatItemAction": {"item": {"liveChatTextMessageRenderer": {"message": {"runs": [{"text": "السلام علیکم استاد احراری شما در جلسه قبل گفتید برای میسر شدن ازدواج هیچ دعا یا ذکری که بخوانیم وجود ندارد پس من چکار کنم تا ازدواج برایم میسر شود و در سجده نماز میشود دعا خواند برای ازدواج ؟"}]}, "authorName": {"simpleText": "@JavadPoghar"}, "authorPhoto": {"thumbnails": [{"url": "https://yt4.ggpht.com/ytc/AIdro_ktf9w-_Y-Ykk2WaCOrvRvto-DqwRfZrCwkWm-etOgO-lhcHcpTYkUtyPAuK6d42C4TAw=s32-c-k-c0x00ffffff-no-rj", "width": 32, "height": 32}, {"url": "https://yt4.ggpht.com/ytc/AIdro_ktf9w-_Y-Ykk2WaCOrvRvto-DqwRfZrCwkWm-etOgO-lhcHcpTYkUtyPAuK6d42C4TAw=s64-c-k-c0x00ffffff-no-rj", "width": 64, "height": 64}]}, "contextMenuEndpoint": {"clickTrackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2ygEE7j9dxw==", "commandMetadata": {"webCommandMetadata": {"ignoreNavigation": true}}, "liveChatItemContextMenuEndpoint": {"params": "Q2g0S0hBb2FRMDkxVjNabWRsTnlOVmxFUm1SM1VERm5RV1JYV0dOUFdVRWFLU29uQ2hoVlEyTldOemMyUWpWbE1UaG9iR0l4WlVaV2JtSnJTMmNTQzJaTU0wTlZWSFZOVERKUklBRW9BVElhQ2hoVlEzVXRSMWxQYjNVd05HVmpUV0oyVlZKMmVWRmlkbmM0QWtnQlVBRSUzRA=="}}, "id": "ChwKGkNPdVd2ZnZTcjVZREZkd1AxZ0FkV1hjT1lB", "timestampUsec": "1787244061876515", "authorExternalChannelId": "UCu-GYOou04ecMbvURvyQbvw", "contextMenuAccessibility": {"accessibilityData": {"label": "Chat actions"}}, "timestampText": {"simpleText": "10:25"}, "trackingParams": "CAEQl98BIhMIm9yM1JDSlgMVdIt8Bh10vzs2"}}, "clientId": "COuWvfvSr5YDFdwP1gAdWXcOYA"}}], "videoOffsetTimeMsec": "625859"}}
