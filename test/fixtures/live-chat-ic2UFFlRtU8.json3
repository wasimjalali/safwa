{"replayChatItemAction": {"actions": [{"addChatItemAction": {"item": {"liveChatTextMessageRenderer": {"message": {"runs": [{"text": "آیا این استدلال درست است در باره نبودن الله بر عرش ؟یک دایره بزرگ را عرش میدانند، یک دایره داخل آن را آسمانها، و نقطه وسط را زمین قرار میدهند و میگویند چون عرش دور آسمانها را از همه طرف احاطه کرده"}]}, "authorName": {"simpleText": "@abdultawabAkberi"}, "authorPhoto": {"thumbnails": [{"url": "https://yt4.ggpht.com/km2J-UQbi0FJrPAQ7Na5ngnar6UfnvrrRLzq6jxjityuxhAK5nrZWRYL-RzVOjAY0yUXw091=s32-c-k-c0x00ffffff-no-rj", "width": 32, "height": 32}, {"url": "https://yt4.ggpht.com/km2J-UQbi0FJrPAQ7Na5ngnar6UfnvrrRLzq6jxjityuxhAK5nrZWRYL-RzVOjAY0yUXw091=s64-c-k-c0x00ffffff-no-rj", "width": 64, "height": 64}]}, "contextMenuEndpoint": {"commandMetadata": {"webCommandMetadata": {"ignoreNavigation": true}}, "liveChatItemContextMenuEndpoint": {"params": "Q2g0S0hBb2FRMDlZUW5KMVlXdDNXbGxFUmxGeVoxQjNVV1J4YUVWc1JHY2FLU29uQ2hoVlEyTldOemMyUWpWbE1UaG9iR0l4WlVaV2JtSnJTMmNTQzJsak1sVkdSbXhTZEZVNElBRW9BVElhQ2hoVlEyOUZUMWxHUTJwT1NGbEdhbEJHTjNCWmJVSnFPVkU0QWtnQlVBRSUzRA=="}}, "id": "ChwKGkNPWEJydWFrd1pZREZRcmdQd1FkcWhFbERn", "timestampUsec": "1787850144858023", "authorExternalChannelId": "UCoEOYFCjNHYFjPF7pYmBj9Q", "contextMenuAccessibility": {"accessibilityData": {"label": "Chat actions"}}, "timestampText": {"simpleText": "32:29"}}}, "clientId": "COXBruakwZYDFQrgPwQdqhElDg"}}], "videoOffsetTimeMsec": "1949398"}}
{"replayChatItemAction": {"actions": [{"addChatItemAction": {"item": {"liveChatTextMessageRenderer": {"message": {"runs": [{"text": "است، و آسمان ها هم دور زمین را احاطه کرده اگر کسی روی زمین به طرف آسمان (بالا) اشاره کند و بگوید «الله بالا است»، این سخن درست نیست؛ چون معلوم نیست «بالا» کدام سمت عرش است"}]}, "authorName": {"simpleText": "@abdultawabAkberi"}, "authorPhoto": {"thumbnails": [{"url": "https://yt4.ggpht.com/km2J-UQbi0FJrPAQ7Na5ngnar6UfnvrrRLzq6jxjityuxhAK5nrZWRYL-RzVOjAY0yUXw091=s32-c-k-c0x00ffffff-no-rj", "width": 32, "height": 32}, {"url": "https://yt4.ggpht.com/km2J-UQbi0FJrPAQ7Na5ngnar6UfnvrrRLzq6jxjityuxhAK5nrZWRYL-RzVOjAY0yUXw091=s64-c-k-c0x00ffffff-no-rj", "width": 64, "height": 64}]}, "contextMenuEndpoint": {"commandMetadata": {"webCommandMetadata": {"ignoreNavigation": true}}, "liveChatItemContextMenuEndpoint": {"params": "Q2g0S0hBb2FRMDFFU1hSUGRXdDNXbGxFUm1GV1JIRjNTV1IwU0UxeVVWRWFLU29uQ2hoVlEyTldOemMyUWpWbE1UaG9iR0l4WlVaV2JtSnJTMmNTQzJsak1sVkdSbXhTZEZVNElBRW9BVElhQ2hoVlEyOUZUMWxHUTJwT1NGbEdhbEJHTjNCWmJVSnFPVkU0QWtnQlVBRSUzRA=="}}, "id": "ChwKGkNNREl0T3Vrd1pZREZhVkRxd0lkdEhNclFR", "timestampUsec": "1787850155455552", "authorExternalChannelId": "UCoEOYFCjNHYFjPF7pYmBj9Q", "contextMenuAccessibility": {"accessibilityData": {"label": "Chat actions"}}, "timestampText": {"simpleText": "32:39"}}}, "clientId": "CMDItOukwZYDFaVDqwIdtHMrQQ"}}], "videoOffsetTimeMsec": "1959983"}}
