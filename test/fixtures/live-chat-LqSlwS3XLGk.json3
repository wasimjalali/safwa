{"replayChatItemAction": {"actions": [{"addChatItemAction": {"item": {"liveChatTextMessageRenderer": {"message": {"runs": [{"text": "استاد محترم، یکی از دوستان ما قصد ازدواج دارند و با وجود کوشش و جستجو، هنوز نتوانستهاند مورد مناسبی پیدا کنند؛ دنبال دختری هستند که حداقل آشنایی خوبی با دین داشته باشد."}]}, "authorName": {"simpleText": "@qurandaily234"}, "authorPhoto": {"thumbnails": [{"url": "https://yt4.ggpht.com/C_He4RF0AWNsM0Y2HZfANEjwOSHwSl2ku3lNo3V_vs48LA5Pcf1jHQptfPZm8aILCdvKJbwi1y4=s32-c-k-c0x00ffffff-no-rj", "width": 32, "height": 32}, {"url": "https://yt4.ggpht.com/C_He4RF0AWNsM0Y2HZfANEjwOSHwSl2ku3lNo3V_vs48LA5Pcf1jHQptfPZm8aILCdvKJbwi1y4=s64-c-k-c0x00ffffff-no-rj", "width": 64, "height": 64}]}, "contextMenuEndpoint": {"commandMetadata": {"webCommandMetadata": {"ignoreNavigation": true}}, "liveChatItemContextMenuEndpoint": {"params": "Q2g0S0hBb2FRMDR0Vm5kMlIwNDVjRmxFUmxJNFV6Rm5RV1JLZW10MlozY2FLU29uQ2hoVlEyTldOemMyUWpWbE1UaG9iR0l4WlVaV2JtSnJTMmNTQzB4eFUyeDNVek5ZVEVkcklBRW9BVElhQ2hoVlEwazBVbGx5UTBrNGRFbHRVM0prYlMxRVUyRkpkMUU0QWtnQlVBRSUzRA=="}}, "id": "ChwKGkNOLVZ3dkdOOXBZREZSOFMxZ0FkSnprdmd3", "timestampUsec": "1789665060367964", "authorExternalChannelId": "UCI4RYrCI8tImSrdm-DSaIwQ", "contextMenuAccessibility": {"accessibilityData": {"label": "Chat actions"}}, "timestampText": {"simpleText": "1:09:35"}}}, "clientId": "CN-VwvGN9pYDFR8S1gAdJzkvgw"}}], "videoOffsetTimeMsec": "4175880"}}
{"replayChatItemAction": {"actions": [{"addChatItemAction": {"item": {"liveChatTextMessageRenderer": {"message": {"runs": [{"text": "السلام علیکم استاد جان. علم ثابت کرده که شکل جنین بعد از هفته ۶ و ۷ از حالت مضغه خارج میشود و نمیتوان گفت مانند گوشت جویده شده دارد ... چنین این فکت را با حدیث که میگوید هر مرحله ۴۰ روز طول میکشد؟"}]}, "authorName": {"simpleText": "@mohammadshoaibazizi9787"}, "authorPhoto": {"thumbnails": [{"url": "https://yt4.ggpht.com/Sxjv02aOydmPc-WH7YLRQYLAQcSjP7s0G3PzPIz5vPKFZfifSXfRRQErC7OQfg-baeC1BdbJ=s32-c-k-c0x00ffffff-no-rj", "width": 32, "height": 32}, {"url": "https://yt4.ggpht.com/Sxjv02aOydmPc-WH7YLRQYLAQcSjP7s0G3PzPIz5vPKFZfifSXfRRQErC7OQfg-baeC1BdbJ=s64-c-k-c0x00ffffff-no-rj", "width": 64, "height": 64}]}, "contextMenuEndpoint": {"commandMetadata": {"webCommandMetadata": {"ignoreNavigation": true}}, "liveChatItemContextMenuEndpoint": {"params": "Q2g0S0hBb2FRMHg1Y1RkbVUwNDVjRmxFUm1aemNURm5RV1J6VFUxdGNVRWFLU29uQ2hoVlEyTldOemMyUWpWbE1UaG9iR0l4WlVaV2JtSnJTMmNTQzB4eFUyeDNVek5ZVEVkcklBRW9BVElhQ2hoVlEweDRja2xQUldSdFJWcDRWM0pDWm5KSE5GaG1YMmM0QWtnQlVBRSUzRA=="}}, "id": "ChwKGkNMeXE3ZlNOOXBZREZmc3ExZ0Fkc01NbXFB", "timestampUsec": "1789665067365102", "authorExternalChannelId": "UCLxrIOEdmEZxWrBfrG4Xf_g", "contextMenuAccessibility": {"accessibilityData": {"label": "Chat actions"}}, "timestampText": {"simpleText": "1:09:42"}}}, "clientId": "CLyq7fSN9pYDFfsq1gAdsMMmqA"}}], "videoOffsetTimeMsec": "4182860"}}
