{"clickTrackingParams": "CAEQl98BIhMIrpjg4oT7lgMV3hdDAx25YwxUygEEwnOATQ==", "replayChatItemAction": {"actions": [{"clickTrackingParams": "CAEQl98BIhMIrpjg4oT7lgMV3hdDAx25YwxUygEEwnOATQ==", "addChatItemAction": {"item": {"liveChatTextMessageRenderer": {"message": {"runs": [{"text": "شما جلسه قبل گفتید از آوردن فرزند نترسید، چون رزق آنها با الله است و مهمترین مسئله تربیت فرزند است و اگر پدر و مادر رفتار مناسبی داشته باشند، فرزند هم خوب تربیت میشود. اما میبینیم پسر حضرت نوح کافر"}]}, "authorName": {"simpleText": "@JavadPoghar"}, "authorPhoto": {"thumbnails": [{"url": "https://yt4.ggpht.com/ytc/AIdro_ktf9w-_Y-Ykk2WaCOrvRvto-DqwRfZrCwkWm-etOgO-lhcHcpTYkUtyPAuK6d42C4TAw=s32-c-k-c0x00ffffff-no-rj", "width": 32, "height": 32}, {"url": "https://yt4.ggpht.com/ytc/AIdro_ktf9w-_Y-Ykk2WaCOrvRvto-DqwRfZrCwkWm-etOgO-lhcHcpTYkUtyPAuK6d42C4TAw=s64-c-k-c0x00ffffff-no-rj", "width": 64, "height": 64}]}, "contextMenuEndpoint": {"clickTrackingParams": "CAEQl98BIhMIrpjg4oT7lgMV3hdDAx25YwxUygEEwnOATQ==", "commandMetadata": {"webCommandMetadata": {"ignoreNavigation": true}}, "liveChatItemContextMenuEndpoint": {"params": "Q2g0S0hBb2FRMG96VjNnNFppMDVXbGxFUmxrelVWQjNVV1JKUlRoWFQxRWFLU29uQ2hoVlEyTldOemMyUWpWbE1UaG9iR0l4WlVaV2JtSnJTMmNTQzB4eFUyeDNVek5ZVEVkcklBRW9BVElhQ2hoVlEzVXRSMWxQYjNVd05HVmpUV0oyVlZKMmVWRmlkbmM0QWtnQlVBRSUzRA=="}}, "id": "ChwKGkNKM1d4OGYtOVpZREZZM1FQd1FkSUU4V09R", "timestampUsec": "1789660945844714", "authorExternalChannelId": "UCu-GYOou04ecMbvURvyQbvw", "contextMenuAccessibility": {"accessibilityData": {"label": "Chat actions"}}, "timestampText": {"simpleText": "1:01"}, "trackingParams": "CAEQl98BIhMIrpjg4oT7lgMV3hdDAx25YwxU"}}, "clientId": "CJ3Wx8f-9ZYDFY3QPwQdIE8WOQ"}}], "videoOffsetTimeMsec": "61344"}}
