{"clickTrackingParams": "CAEQl98BIhMIrpjg4oT7lgMV3hdDAx25YwxUygEEwnOATQ==", "replayChatItemAction": {"actions": [{"clickTrackingParams": "CAEQl98BIhMIrpjg4oT7lgMV3hdDAx25YwxUygEEwnOATQ==", "addChatItemAction": {"item": {"liveChatTextMessageRenderer": {"message": {"runs": [{"text": "میشه لطفا تعداد نماز های سنت قبل و بعد از ادای نماز جمعه را بگویید. هرکس یک مقدار میگه. اینکه در چه زمانی دقیقا بخوانیم، چند رکعت بخوانیم در خانه بخوانیم چند رکعته و اگه به مسجد بخوانیم چند رکعته."}]}, "authorName": {"simpleText": "@ehsanahmadi6844"}, "authorPhoto": {"thumbnails": [{"url": "https://yt4.ggpht.com/ytc/AIdro_mAICp2xjabCkQvwYsHw9QaD1USje1E55oq38F--b0eghR4aHfruOcp1psLgHN6B8Gx9w=s32-c-k-c0x00ffffff-no-rj", "width": 32, "height": 32}, {"url": "https://yt4.ggpht.com/ytc/AIdro_mAICp2xjabCkQvwYsHw9QaD1USje1E55oq38F--b0eghR4aHfruOcp1psLgHN6B8Gx9w=s64-c-k-c0x00ffffff-no-rj", "width": 64, "height": 64}]}, "contextMenuEndpoint": {"clickTrackingParams": "CAEQl98BIhMIrpjg4oT7lgMV3hdDAx25YwxUygEEwnOATQ==", "commandMetadata": {"webCommandMetadata": {"ignoreNavigation": true}}, "liveChatItemContextMenuEndpoint": {"params": "Q2g0S0hBb2FRMDlEU21saVZGODVXbGxFUm1WMmIxQjNVV1IzZGxsU00yY2FLU29uQ2hoVlEyTldOemMyUWpWbE1UaG9iR0l4WlVaV2JtSnJTMmNTQzB4eFUyeDNVek5ZVEVkcklBRW9BVElhQ2hoVlExUk9OMlpmV0UxV2RWSkxWRGxqV25SVE1IRk1NVUU0QWtnQlVBRSUzRA=="}}, "id": "ChwKGkNPQ0ppYlRfOVpZREZldm9Qd1Fkd3ZZUjNn", "timestampUsec": "1789661173404658", "authorExternalChannelId": "UCTN7f_XMVuRKT9cZtS0qL1A", "contextMenuAccessibility": {"accessibilityData": {"label": "Chat actions"}}, "timestampText": {"simpleText": "4:48"}, "trackingParams": "CAEQl98BIhMIrpjg4oT7lgMV3hdDAx25YwxU"}}, "clientId": "COCJibT_9ZYDFevoPwQdwvYR3g"}}], "videoOffsetTimeMsec": "288901"}}
