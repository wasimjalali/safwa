{"clickTrackingParams": "CAEQl98BIhMI5eOd2pDSlgMV5B8GAB3UnhQHygEEpuUt5w==", "replayChatItemAction": {"actions": [{"clickTrackingParams": "CAEQl98BIhMI5eOd2pDSlgMV5B8GAB3UnhQHygEEpuUt5w==", "addChatItemAction": {"item": {"liveChatTextMessageRenderer": {"message": {"runs": [{"text": "است، و آسمان ها هم دور زمین را احاطه کرده اگر کسی روی زمین به طرف آسمان (بالا) اشاره کند و بگوید «الله بالا است»، این سخن درست نیست؛ چون معلوم نیست «بالا» کدام سمت عرش است."}]}, "authorName": {"simpleText": "@abdultawabAkberi"}, "authorPhoto": {"thumbnails": [{"url": "https://yt4.ggpht.com/km2J-UQbi0FJrPAQ7Na5ngnar6UfnvrrRLzq6jxjityuxhAK5nrZWRYL-RzVOjAY0yUXw091=s32-c-k-c0x00ffffff-no-rj", "width": 32, "height": 32}, {"url": "https://yt4.ggpht.com/km2J-UQbi0FJrPAQ7Na5ngnar6UfnvrrRLzq6jxjityuxhAK5nrZWRYL-RzVOjAY0yUXw091=s64-c-k-c0x00ffffff-no-rj", "width": 64, "height": 64}]}, "contextMenuEndpoint": {"clickTrackingParams": "CAEQl98BIhMI5eOd2pDSlgMV5B8GAB3UnhQHygEEpuUt5w==", "commandMetadata": {"webCommandMetadata": {"ignoreNavigation": true}}, "liveChatItemContextMenuEndpoint": {"params": "Q2g0S0hBb2FRMGxVVG5JNU4zZ3RjRlZFUmxwRVJGQjNVV1I1TVZWUFExRWFLU29uQ2hoVlEyTldOemMyUWpWbE1UaG9iR0l4WlVaV2JtSnJTMmNTQzBsRVowbE1hQzB0VUhkSklBRW9BVElhQ2hoVlEyOUZUMWxHUTJwT1NGbEdhbEJHTjNCWmJVSnFPVkU0QWtnQlVBRSUzRA=="}}, "id": "ChwKGkNJVE5yOTd4LXBVREZaRERQd1FkeTFVT0NR", "timestampUsec": "1785431256203475", "authorExternalChannelId": "UCoEOYFCjNHYFjPF7pYmBj9Q", "contextMenuAccessibility": {"accessibilityData": {"label": "Chat actions"}}, "timestampText": {"simpleText": "5:52"}, "trackingParams": "CAEQl98BIhMI5eOd2pDSlgMV5B8GAB3UnhQH"}}, "clientId": "CITNr97x-pUDFZDDPwQdy1UOCQ"}}], "videoOffsetTimeMsec": "352500"}}
