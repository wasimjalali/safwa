{"clickTrackingParams": "CAEQl98BIhMI5eOd2pDSlgMV5B8GAB3UnhQHygEEpuUt5w==", "replayChatItemAction": {"actions": [{"clickTrackingParams": "CAEQl98BIhMI5eOd2pDSlgMV5B8GAB3UnhQHygEEpuUt5w==", "addChatItemAction": {"item": {"liveChatTextMessageRenderer": {"message": {"runs": [{"text": "رحیمالله حقانی درباره نبودن الله بر عرش چنین استدلالی میکند:یک دایره بزرگ را عرش، یک دایره داخل آن را آسمانها، و نقطه وسط را زمین قرار میدهد و میگوید چون عرش دور آسمانها را از همه طرف احاطه کرده"}]}, "authorName": {"simpleText": "@abdultawabAkberi"}, "authorPhoto": {"thumbnails": [{"url": "https://yt4.ggpht.com/km2J-UQbi0FJrPAQ7Na5ngnar6UfnvrrRLzq6jxjityuxhAK5nrZWRYL-RzVOjAY0yUXw091=s32-c-k-c0x00ffffff-no-rj", "width": 32, "height": 32}, {"url": "https://yt4.ggpht.com/km2J-UQbi0FJrPAQ7Na5ngnar6UfnvrrRLzq6jxjityuxhAK5nrZWRYL-RzVOjAY0yUXw091=s64-c-k-c0x00ffffff-no-rj", "width": 64, "height": 64}]}, "contextMenuEndpoint": {"clickTrackingParams": "CAEQl98BIhMI5eOd2pDSlgMV5B8GAB3UnhQHygEEpuUt5w==", "commandMetadata": {"webCommandMetadata": {"ignoreNavigation": true}}, "liveChatItemContextMenuEndpoint": {"params": "Q2g0S0hBb2FRMHhQTUdkT2JuZ3RjRlZFUm1WaVJWQjNVV1JzTmtWQ2VXY2FLU29uQ2hoVlEyTldOemMyUWpWbE1UaG9iR0l4WlVaV2JtSnJTMmNTQzBsRVowbE1hQzB0VUhkSklBRW9BVElhQ2hoVlEyOUZUMWxHUTJwT1NGbEdhbEJHTjNCWmJVSnFPVkU0QWtnQlVBRSUzRA=="}}, "id": "ChwKGkNMTzBnTm54LXBVREZlYkVQd1FkbDZFQnln", "timestampUsec": "1785431244944023", "authorExternalChannelId": "UCoEOYFCjNHYFjPF7pYmBj9Q", "contextMenuAccessibility": {"accessibilityData": {"label": "Chat actions"}}, "timestampText": {"simpleText": "5:41"}, "trackingParams": "CAEQl98BIhMI5eOd2pDSlgMV5B8GAB3UnhQH"}}, "clientId": "CLO0gNnx-pUDFebEPwQdl6EByg"}}], "videoOffsetTimeMsec": "341291"}}
